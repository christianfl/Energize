{
  "id": "com.flasskamp.energize",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "energize",
  "finish-args": [
    "--share=network",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--filesystem=xdg-download"
  ],
  "modules": [
    {
      "name": "energize",
      "buildsystem": "simple",
      "only-arches": [
        "x86_64",
        "aarch64"
      ],
      "build-commands": [
        "mkdir -p /app/energize",
        "cp -r energize/energize/. /app/energize/",
        "mkdir -p /app/bin /app/lib",
        "ln -s /app/energize/energize /app/bin/energize",
        "ln -s /usr/lib/x86_64-linux-gnu/libsqlite3.so.0 /app/lib/libsqlite3.so",
        "if [ ! -e '/app/lib/libsqlite3.so' ]; then ln -s -f /usr/lib/aarch64-linux-gnu/libsqlite3.so.0 /app/lib/libsqlite3.so; fi",
        "if [ $(arch) == \"aarch64\" ]; then sed -si \"/Exec=/cExec=env GDK_GL=gles energize\" com.flasskamp.energize.desktop; fi",
        "install -Dm644 com.flasskamp.energize.desktop /app/share/applications/com.flasskamp.energize.desktop",
        "install -Dm644 com.flasskamp.energize.metainfo.xml /app/share/appdata/com.flasskamp.energize.metainfo.xml",
        "install -Dm644 com.flasskamp.energize.svg /app/share/icons/hicolor/scalable/apps/com.flasskamp.energize.svg"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://codeberg.org/epinez/Energize/releases/download/v0.15.0/energize-linux-x86-64-release.tar.gz",
          "dest": "energize",
          "sha256": "263b03b6ed1eefa4b401e702193d890c29e35a7c38a73225f35e73e0f900cdb6"
        },
        {
          "type": "archive",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://codeberg.org/epinez/Energize/releases/download/v0.15.0/energize-linux-aarch64-release.tar.gz",
          "dest": "energize",
          "sha256": "bdbfe2537a2dd5c837d0249485bcc1979ef00dbabe47cbfcdad55418a84acb24"
        },
        {
          "type": "file",
          "path": "com.flasskamp.energize.metainfo.xml"
        },
        {
          "type": "file",
          "path": "com.flasskamp.energize.desktop"
        },
        {
          "type": "file",
          "path": "com.flasskamp.energize.svg"
        }
      ]
    }
  ]
}
